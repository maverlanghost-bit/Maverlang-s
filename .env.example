# ===== Modo de datos =====
DATA_MODE=mock                      # mock | live  (mock mientras se construye)
NEXT_PUBLIC_DATA_MODE=mock
# Precio actual recomendado en local: live.
# live = precio actual desde Jupiter Price v3 (usdPrice, ya por acción). mock = sin red.
# Si la variable no existe, el código usa mock (tests y CI).
# Si Jupiter falla o falta un ticker, se usa la ancla y se muestra "Precio de referencia".
# Con live, el gráfico ilustrativo termina en ese precio y el dólar sale de FX_SOURCE_URL.
# Si el dólar falla, no se inventa uno: los precios quedan en USD.
# No enciende el trade real ni la auth: eso sigue en DATA_MODE. La cartera demo sí usa este precio.
PRICES_MODE=live                    # mock | live

# ===== Auth =====
# mock (por defecto) | supabase.
# Supabase sólo si el flag es supabase y hay URL + clave pública.
# Si falta algo, la app sigue en mock (un aviso en consola, una vez).
# El servidor lee AUTH_MODE. El cliente lee NEXT_PUBLIC_AUTH_MODE. Tienen que coincidir.
# DATA_MODE y PRICES_MODE no cambian. Privy sigue en el código; con supabase no manda.
AUTH_MODE=mock
NEXT_PUBLIC_AUTH_MODE=mock

# ===== Marca / sitio =====
NEXT_PUBLIC_BRAND_NAME="Maverlang Stocks"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# ===== Privy (auth + wallet embebida) =====
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=                   # sólo servidor

# ===== Solana =====
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=         # RPC público con rate-limit para lecturas cliente
SOLANA_RPC_URL=                     # RPC privado (Helius/Triton…) sólo servidor

# ===== Jupiter =====
JUPITER_BASE_URL=https://api.jup.ag   # origen. El servicio llama a /price/v3 en lotes de hasta 50
JUPITER_API_KEY=                    # opcional, sólo servidor. Se manda como header x-api-key a https://api.jup.ag (nunca en la URL). Sin clave, Jupiter acepta pocas consultas por segundo y responde 429 con facilidad; ante un 429 el mercado muestra el último precio guardado.

# ===== Comisión propia =====
FEE_BPS=0                           # 0 al lanzamiento
FEE_WALLET=                         # dueño de la cuenta USDC que recibe comisiones
PRICE_DEVIATION_MAX_BPS=150
DEFAULT_SLIPPAGE_BPS=50

# ===== Patrocinio de gas (por decidir; en prod usar KMS, nunca clave en env) =====
SPONSOR_ENABLED=false

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                # sólo servidor. Alias aceptado: SUPABASE_SERVICE_ROLE_KEY

# ===== On-ramp =====
ONRAMP_PROVIDER=koywe               # koywe | onramper
KOYWE_CLIENT_ID=
KOYWE_SECRET=                       # sólo servidor
KOYWE_WEBHOOK_SECRET=
ONRAMPER_API_KEY=

# ===== FX =====
# Con PRICES_MODE=live se consulta esta URL (dólar observado). Cache 45 min. Timeout 2,5 s.
# /api/fx/usdclp responde source live|mock y la fecha. Si falla, no hay tasa de relleno.
FX_SOURCE_URL=https://mindicador.cl/api/dolar   # [VERIFICAR términos de uso]

# ===== Cumplimiento =====
GEO_BLOCKED_COUNTRIES=US
TERMS_VERSION=2026-10-draft
PRIVACY_VERSION=2026-10-draft
RISKS_VERSION=2026-10-draft

# ===== Catálogo =====
# curated (50 símbolos) | all (tabla Supabase completa, 1171 filas). curated es el máximo por defecto.
CATALOG_SCOPE=curated
